# Copy this file to .env and fill in your own Supabase project credentials.
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Never put the service_role key in the frontend. It is only used, if at all,
# in a server-side Supabase Edge Function (see supabase/functions).
